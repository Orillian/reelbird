---
interface Props { eyebrow?: string; title: string; lede?: string; crumbs?: { name: string; path: string }[]; class?: string }
const { eyebrow, title, lede, crumbs = [], class: cls = "" } = Astro.props;
---
<header class:list={["page-head wrap", cls]}>
  {crumbs.length > 0 && (
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        {crumbs.map((c, i) => <li>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.path}>{c.name}</a>}</li>)}
      </ol>
    </nav>
  )}
  {eyebrow && crumbs.length === 0 && <p class="eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  {lede && <p class="lede">{lede}</p>}
  <slot />
</header>
