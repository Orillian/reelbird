---
// The robin, at most once per screen (brand/colors.md). Body follows the theme; the breast is the record light.
interface Props { pose?: "idle" | "celebrating" | "sleeping" | "recording"; size?: number; class?: string }
const { pose = "idle", size = 120, class: cls = "" } = Astro.props;
const BODY = "M204 70C196 54 182 45 164 45C144 45 130 55 120 67C96 88 50 128 22 166Q15 177 28 181L72 177C86 201 108 213 132 213C176 213 206 182 210 140C212 120 210 106 205 98";
const BEAK = "L230.5 88.6Q236 86.4 230.6 84.2Z";
---
<svg class={cls} width={size} height={size} viewBox="0 0 256 256" aria-hidden="true">
  {pose === "celebrating" ? (
    <>
      <g transform="rotate(-8 128 140) translate(0 -10)">
        <path d="M124 94C108 66 88 42 62 26C55 22 49 27 51 34C53 41 56 47 60 52C55 53 53 57 56 61C62 70 69 78 76 85C71 87 70 92 74 96C82 104 91 112 100 118Z" fill="currentColor" />
        <path d={`${BODY}Z`} fill="currentColor" />
        <path d="M203 70L233 70.5Q238 71.5 233.5 75L205 86Z" fill="currentColor" />
        <path d="M205 91L228 102Q231.5 104.5 227 105L205 99Z" fill="currentColor" />
        <circle cx="146" cy="149" r="40" fill="#FF5A36" />
        <path d="M169 84Q177 74 185 84" fill="none" stroke="var(--bg)" stroke-width="5" stroke-linecap="round" />
        <path d="M116 210L104 228M144 211L136 230" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" />
      </g>
      <path d="M222 34L230 20M240 52L254 46M206 26L206 12" fill="none" stroke="#FF5A36" stroke-width="6" stroke-linecap="round" />
    </>
  ) : pose === "sleeping" ? (
    <g transform="translate(0 18)">
      <path d={`${BODY}${BEAK}`} fill="currentColor" />
      <circle cx="146" cy="149" r="37" fill="none" stroke="#FF5A36" stroke-width="6" />
      <path d="M169 80Q177 88 185 80" fill="none" stroke="var(--bg)" stroke-width="5" stroke-linecap="round" />
    </g>
  ) : (
    <>
      <path d={`${BODY}${BEAK}`} fill="currentColor" />
      <circle cx="146" cy="149" r="40" fill="#FF5A36" />
      <circle cx="177" cy="80" r="8" fill="var(--bg)" />
      {pose === "recording" && <circle cx="146" cy="149" r="51" fill="none" stroke="#FF5A36" stroke-width="5" />}
      <path d="M118 211L112 238M146 211L150 238" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" />
    </>
  )}
</svg>
