---
import Illustration from "./Illustration.astro";
import perch from "../assets/illustrations/perch.webp";
import perchDark from "../assets/illustrations/perch-dark.webp";
import Icon from "./Icon.astro";
import { GITHUB_URL } from "../config/site";
interface Props { title?: string; text?: string; mascot?: boolean }
const {
  title = "Record your first take in a few minutes.",
  text = "Download it, drag it to Applications and look for the robin in your menu bar. Free, with no account. Mac only, macOS 15 or later.",
  mascot = true,
} = Astro.props;
---
<section class="cta section" aria-labelledby="cta-title">
  <div class="wrap inner">
    {mascot && <Illustration src={perch} dark={perchDark} size={200} class="bird" />}
    <h2 id="cta-title">{title}</h2>
    <p class="lede">{text}</p>
    <div class="buttons">
      <a class="btn btn-primary" href="/download/"><Icon name="download" />Get Reelbird — free</a>
      <a class="btn btn-ghost" href={GITHUB_URL}><Icon name="github" />Source on GitHub</a>
    </div>
  </div>
</section>

<style>
  .inner { display: grid; justify-items: center; text-align: center; gap: 1.25rem; }
  .inner :global(.bird) { color: var(--text); margin-bottom: 0.25rem; }
  h2 { max-width: 18ch; }
  .lede { margin-inline: auto; }
  .buttons { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: 0.5rem; }
</style>
