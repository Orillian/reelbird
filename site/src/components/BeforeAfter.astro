---
// The raw take and Reelbird's export at the same moment, side by side.
import { Picture } from "astro:assets";
import before from "../assets/shots/zoom-before.webp";
import after from "../assets/shots/zoom-after.webp";
const sizes = "(min-width: 72rem) 540px, (min-width: 48rem) 50vw, 100vw";
const widths = [480, 720, 1080, 1440];
---
<div class="pair">
  <figure>
    <div class="frame"><Picture src={before} widths={widths} sizes={sizes} formats={["avif", "webp"]} fallbackFormat="webp" alt="The raw recording at 0:05: the whole screen, small text, and no cursor yet, because Reelbird draws it later." loading="lazy" /></div>
    <figcaption><span class="t">0:05</span> What you recorded</figcaption>
  </figure>
  <span class="arrow" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
  <figure>
    <div class="frame"><Picture src={after} widths={widths} sizes={sizes} formats={["avif", "webp"]} fallbackFormat="webp" alt="Reelbird's export at the same moment: zoomed in on the task field you clicked, with a redrawn cursor." loading="lazy" /></div>
    <figcaption><span class="t">0:05</span> What you share, zoomed on your click</figcaption>
  </figure>
</div>

<style>
  .pair { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: clamp(0.75rem, 0.5rem + 1vw, 1.5rem); }
  figure { display: grid; gap: 0.85rem; }
  figcaption { font-size: var(--step--1); color: var(--text-muted); }
  .t { font-family: var(--font-mono); font-size: 0.8125rem; color: var(--text); margin-right: 0.4rem; }
  .arrow { color: var(--text-muted); margin-top: -2rem; }
  @media (max-width: 48rem) {
    .pair { grid-template-columns: minmax(0, 1fr); }
    .arrow { justify-self: center; rotate: 90deg; margin: 0; }
  }
</style>
