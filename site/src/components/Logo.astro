    <g transform="translate(270 172.5) scale(0.64)">
      <path d={WORD} fill="none" stroke="currentColor" stroke-width="24" stroke-linecap="round" stroke-linejoin="round" />
      <circle cx="491" cy="-124" r="15" fill="currentColor" />
    </g>
  </svg>
)}
