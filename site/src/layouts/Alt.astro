---
// "X alternative" pages: H1 with the keyword, the canonical sentence, a dated fact table,
// where the other app is better, a short clip, FAQ and the install CTA with its caveat.
import Base from "./Base.astro";
import PageHead from "../components/PageHead.astro";
import ClipLoop from "../components/ClipLoop.astro";
import Faq from "../components/Faq.astro";
import Icon from "../components/Icon.astro";
import type { Faq as FaqItem } from "../data/faq";
import { CHECKED_LABEL, byId } from "../data/compare";
import { GITHUB_URL, SITE_DESCRIPTION } from "../config/site";

interface Props {
  seoTitle: string; description: string; path: string; og: string;
  title: string; intro: string; rival: string;
  rows: [string, string, string][];
  better: string[];
  ours: string[];
  faq: FaqItem[];
}
const { seoTitle, description, path, og, title, intro, rival, rows, better, ours, faq } = Astro.props;
const r = byId(rival);
const crumbs = [{ name: title, path }];
---
<Base title={seoTitle} description={description} og={og} crumbs={crumbs} type="article">
  <PageHead title={title} lede={SITE_DESCRIPTION} crumbs={crumbs}>
    <p class="intro">{intro}</p>
    <div class="cta">
      <a class="btn btn-primary" href="/download/"><Icon name="download" />Get Reelbird — free</a>
      <span class="caveat">Build from source on macOS 15 or later. Mac only. A few minutes, no Xcode.</span>
    </div>
  </PageHead>

  <section class="wrap block" aria-labelledby="facts">
    <h2 id="facts">Reelbird and {r.name}, side by side</h2>
    <div class="table-wrap">
      <table class="facts">
        <caption>Prices and features checked {CHECKED_LABEL}. Sources: {r.sources.map((s, i) => <>{i > 0 && ", "}<a href={s.href}>{s.label}</a></>)}.</caption>
        <thead><tr><th scope="col"><span class="sr-only">Fact</span></th><th scope="col">Reelbird</th><th scope="col">{r.name}</th></tr></thead>
        <tbody>
          {rows.map(([k, a, b]) => <tr><th scope="row">{k}</th><td>{a}</td><td>{b}</td></tr>)}
        </tbody>
      </table>
    </div>
  </section>

  <section class="wrap block two" aria-label="Strengths">
    <div>
      <h2>Where {r.name} is better</h2>
      <ul class="plain">{better.map((b) => <li set:html={b} />)}</ul>
    </div>
    <div>
      <h2>Where Reelbird fits</h2>
      <ul class="plain">{ours.map((b) => <li set:html={b} />)}</ul>
    </div>
  </section>

  <section class="wrap block" aria-labelledby="clip">
    <h2 id="clip">An auto-zoom export, as it comes out</h2>
    <ClipLoop />
  </section>

  <section class="wrap block faq" aria-labelledby="alt-faq">
    <h2 id="alt-faq">Questions</h2>
    <Faq items={faq} />
    <p class="more"><a class="link-arrow" href="/compare/">Compare more Mac screen recorders</a></p>
  </section>

  <section class="wrap block end">
    <h2>Try it on your own screen.</h2>
    <p class="muted">Clone, <code>make install</code>, record. If it isn't for you, delete the app; nothing else was installed.</p>
    <div class="cta">
      <a class="btn btn-primary" href="/download/"><Icon name="download" />Get Reelbird — free</a>
      <a class="btn btn-ghost" href={GITHUB_URL}><Icon name="github" />Source on GitHub</a>
    </div>
  </section>
</Base>

<style>
  .intro { margin-top: 1rem; max-width: 40rem; color: var(--text-muted); font-size: 1.0625rem; }
  .cta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.25rem; margin-top: 2rem; }
  .caveat { font-size: var(--step--1); color: var(--text-muted); max-width: 22rem; }
  .block { padding-block: clamp(2.5rem, 2rem + 2vw, 4rem); border-top: 1px solid var(--line); }
  .block h2 { font-size: var(--step-3); margin-bottom: 1.75rem; }
  .facts { font-size: 0.975rem; min-width: 36rem; }
  .facts caption { caption-side: bottom; text-align: left; padding-top: 1rem; font-size: var(--step--1); color: var(--text-muted); }
  .facts caption a { color: inherit; }
  .facts th[scope="row"] { color: var(--text); font-weight: 600; width: 22%; font-size: 0.95rem; }
  .facts td { width: 39%; color: var(--text-muted); }
  .facts td:first-of-type { color: var(--text); }
  .facts thead th { font-size: 1rem; color: var(--text); }
  .two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3rem; }
  .two h2 { font-size: var(--step-2); }
  .plain { padding-left: 1.1rem; display: grid; gap: 0.7rem; color: var(--text-muted); }
  .faq { max-width: 52rem; margin-inline: auto; }
  .more { margin-top: 2rem; }
  .end { text-align: center; display: grid; justify-items: center; gap: 0.5rem; padding-bottom: var(--section); }
  .end h2 { margin-bottom: 0.5rem; }
  .end .cta { justify-content: center; }
  @media (max-width: 48rem) { .two { grid-template-columns: minmax(0, 1fr); } }
</style>
