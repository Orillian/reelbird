---
import Base from "./Base.astro";
import { getCollection } from "astro:content";
import { GITHUB_URL } from "../config/site";
import { techArticle } from "../lib/jsonld";

interface Props {
  title: string; seoTitle: string; description: string; path: string; updated: string; source?: string;
  headings?: { depth: number; slug: string; text: string }[];
}
const { title, seoTitle, description, path, updated, source, headings = [] } = Astro.props;
const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
const toc = headings.filter((h) => h.depth === 2);
const crumbs = [{ name: "Docs", path: "/docs/" }, ...(path === "/docs/" ? [] : [{ name: title, path }])];
---
<Base title={seoTitle} description={description} og={path === "/docs/" ? "docs" : `docs-${path.split("/")[2]}`} crumbs={crumbs} type="article"
  schema={[techArticle({ title: seoTitle, description, path, dateModified: updated })]}>
  <div class="wrap docs">
    <nav class="side" aria-label="Documentation">
      <p class="side-title"><a href="/docs/">Docs</a></p>
      <ul>
        {docs.map((d) => <li><a href={`/docs/${d.id}/`} aria-current={path === `/docs/${d.id}/` ? "page" : undefined}>{d.data.title}</a></li>)}
      </ul>
      <p class="side-title">Elsewhere</p>
      <ul>
        <li><a href="/download/">Download</a></li>
        <li><a href="/faq/">FAQ</a></li>
        <li><a href="/changelog/">Changelog</a></li>
      </ul>
    </nav>
    <article class="content">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          {crumbs.map((c, i) => <li>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.path}>{c.name}</a>}</li>)}
        </ol>
      </nav>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <div class="prose body"><slot /></div>
      <footer class="meta">
        <span>Updated {new Date(updated + "T12:00:00Z").toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })}</span>
        {source && <a href={`${GITHUB_URL}/blob/main/${source}`}>Edit {source} on GitHub</a>}
        {path !== "/docs/" && <a href={`${path.replace(/\/$/, "")}.md`}>Markdown</a>}
      </footer>
    </article>
    {toc.length > 1 && (
      <nav class="toc" aria-label="On this page">
        <p class="side-title">On this page</p>
        <ul>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
      </nav>
    )}
  </div>
</Base>

<script>
  // Copy buttons for the Markdown code blocks.
  document.querySelectorAll<HTMLPreElement>(".body pre.astro-code").forEach((pre) => {
    pre.tabIndex = 0;
    const wrap = document.createElement("div");
    wrap.className = "md-code";
    pre.replaceWith(wrap);
    wrap.append(pre);
    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "md-copy";
    btn.textContent = "Copy";
    btn.setAttribute("aria-label", "Copy code");
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText.trimEnd());
        btn.textContent = "Copied";
        setTimeout(() => (btn.textContent = "Copy"), 1600);
      } catch {}
    });
    wrap.append(btn);
  });
</script>

<style>
  .body :global(.md-code) { position: relative; display: flex; align-items: flex-start; background: var(--code-bg); border-radius: var(--radius); margin-block: 1.4em; }
  .body :global(.md-code pre) { flex: 1; min-width: 0; margin: 0 !important; background: transparent !important; }
  .body :global(.md-copy) {
    flex: none; margin: 0.55rem 0.55rem 0.55rem 0; height: 2rem; padding: 0 0.7rem; border-radius: 8px;
    border: 1px solid var(--line-strong); background: var(--bg-raised); color: var(--text-muted); font-size: 0.8125rem; font-weight: 600;
  }
  .body :global(.md-copy:hover) { color: var(--text); }
  .docs { display: grid; grid-template-columns: 13rem minmax(0, 1fr) 13rem; gap: clamp(2rem, 1rem + 3vw, 4rem); padding-block: clamp(2.5rem, 2rem + 2vw, 4rem) var(--section); align-items: start; }
  .side, .toc { position: sticky; top: 5.5rem; font-size: 0.9375rem; max-height: calc(100dvh - 7rem); overflow-y: auto; }
  .side-title { font-size: var(--step--1); font-weight: 600; color: var(--text); margin: 0 0 0.6rem; }
  .side-title:not(:first-child) { margin-top: 1.75rem; }
  .side-title a { text-decoration: none; }
  .side ul, .toc ul { list-style: none; padding: 0; display: grid; gap: 0.15rem; }
  .side a, .toc a { display: block; padding: 0.3rem 0; color: var(--text-muted); text-decoration: none; line-height: 1.4; }
  .side a:hover, .toc a:hover { color: var(--text); }
  .side a[aria-current="page"] { color: var(--text); font-weight: 600; }
  .toc a { font-size: 0.875rem; }
  .content { min-width: 0; max-width: 46rem; }
  .content h1 { font-size: clamp(2.1rem, 1.6rem + 2vw, 3rem); margin-top: 1rem; }
  .content .lede { margin-top: 1rem; font-size: 1.125rem; }
  .body { margin-top: 2.5rem; max-width: none; }
  .meta { margin-top: 4rem; padding-top: 1.25rem; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; font-size: var(--step--1); color: var(--text-muted); }
  .meta a { color: inherit; }
  @media (max-width: 72rem) { .docs { grid-template-columns: 12rem minmax(0, 1fr); } .toc { display: none; } }
  @media (max-width: 52rem) {
    .docs { grid-template-columns: minmax(0, 1fr); }
    .side { position: static; max-height: none; order: 2; border-top: 1px solid var(--line); padding-top: 2rem; }
  }
</style>
