---
import Base from "../layouts/Base.astro";
import Illustration from "../components/Illustration.astro";
import sleeping from "../assets/illustrations/sleeping.webp";
---
<Base title="Page not found" description="This page doesn't exist." og="home" noindex>
  <section class="wrap nf">
    <Illustration src={sleeping} size={220} eager />
    <h1>Nothing recorded here.</h1>
    <p class="lede">The page you asked for doesn't exist, or it moved.</p>
    <div class="links">
      <a class="btn btn-ink" href="/">Home</a>
      <a class="btn btn-ghost" href="/docs/">Docs</a>
      <a class="btn btn-ghost" href="/download/">Download</a>
    </div>
  </section>
</Base>

<style>
  .nf { display: grid; justify-items: center; text-align: center; gap: 1.25rem; padding-block: clamp(3rem, 2rem + 5vw, 7rem) var(--section); }
  .nf h1 { font-size: var(--step-3); }
  .lede { margin-inline: auto; }
  .links { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: 0.5rem; }
</style>
