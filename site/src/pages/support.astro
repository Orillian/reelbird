---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Illustration from "../components/Illustration.astro";
import Icon from "../components/Icon.astro";
import celebrating from "../assets/illustrations/celebrating.webp";
import celebratingDark from "../assets/illustrations/celebrating-dark.webp";
import { DONATION_LINKS, GITHUB_URL, PRO } from "../config/site";
const crumbs = [{ name: "Support", path: "/support/" }];
const lede = PRO.launched
  ? "Reelbird is free and MIT licensed, with no watermarks or limits. The best way to support it is Reelbird Pro, which hosts your links for you. If you don't need that, you can chip in once or every month."
  : "Reelbird is free, MIT licensed and has no paid tier. If it saves you time, you can chip in once or every month. It pays for the hours that go into fixes, new features and, soon, a signed download.";
---
<Base title="Support Reelbird" description={PRO.launched ? "Reelbird is free and MIT licensed. Reelbird Pro, or a one-time or monthly donation, keeps it maintained." : "Reelbird is free and MIT licensed. One-time or monthly support keeps it maintained."} og="support" crumbs={crumbs}>
  <div class="wrap top">
    <PageHead title="Support Reelbird" lede={lede} crumbs={crumbs} class="head" />
    <Illustration src={celebrating} dark={celebratingDark} size={220} class="art" eager />
  </div>

  {PRO.launched && (
    <div class="wrap">
      <section class="pro" aria-labelledby="pro-title">
        <div>
          <h2 id="pro-title">Reelbird Pro <span class="price">{PRO.price}<span class="per">/month</span></span></h2>
          <p class="muted">Share without setting up storage: Reelbird hosts your links (unlimited, {PRO.storage}), with anonymous analytics that show how many people watched, where they stopped and where they came from. Recording, editing, exporting and sharing to your own bucket stay free. <a href="/pricing/">Free and Pro compared</a>.</p>
        </div>
        <a class="btn btn-primary" href={PRO.upgradeURL}><Icon name="arrowRight" />Get Reelbird Pro</a>
      </section>
    </div>
  )}

  <div class="wrap tiers">
    <section class="once" aria-labelledby="once-title">
      <h2 id="once-title">Once</h2>
      <p class="muted">Any amount you like. Stripe handles the payment; Reelbird never sees your card.</p>
      <a class={PRO.launched ? "btn btn-ghost" : "btn btn-primary"} href={DONATION_LINKS.once}><Icon name="heart" />Give once</a>
    </section>

    <section class="monthly" aria-labelledby="monthly-title">
      <h2 id="monthly-title">Monthly</h2>
      <p class="muted">Cancel whenever you like from the receipt email.</p>
      <ul>
        {DONATION_LINKS.monthly.map((t) => (
          <li>
            <a href={t.href}>
              <span class="amt">{t.amount}<span class="per">/month</span></span>
              <span class="name">{t.name}</span>
              <Icon name="arrowRight" size={18} class="go" />
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <section class="wrap other" aria-labelledby="other-title">
    <h2 id="other-title">Other ways to help</h2>
    <ul>
      <li><strong>Report a bug</strong> with steps to reproduce. It's as useful as code. <a href={`${GITHUB_URL}/issues`}>Open an issue</a></li>
      <li><strong>Fix something.</strong> The build needs only the Command Line Tools. <a href={`${GITHUB_URL}/blob/main/CONTRIBUTING.md`}>Contributing guide</a></li>
      <li><strong>Tell someone</strong> who records demos, bug reports or tutorials on a Mac.</li>
    </ul>
    <p class="muted thanks">Thank you. Every bit of it goes back into Reelbird.</p>
  </section>
</Base>

<style>
  .top { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 2rem; }
  .top :global(.head) { width: auto; margin: 0; padding-inline: 0; }
  .top :global(.art) { margin-bottom: 2rem; }
  .pro { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 1.5rem 2rem; margin-bottom: 2rem; padding: 1.75rem; border-radius: var(--radius-lg); border: 1px solid var(--line-strong); background: var(--bg-raised); }
  .pro h2 { font-size: var(--step-2); display: flex; align-items: baseline; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 0.5rem; }
  .pro .price { font-family: var(--font-display); font-size: 1.25rem; font-weight: 520; }
  .pro p { max-width: 44rem; }
  .tiers { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 2rem; padding-bottom: 4rem; }
  .tiers section { border: 1px solid var(--line-strong); border-radius: var(--radius-lg); padding: 1.75rem; background: var(--bg-raised); display: grid; align-content: start; gap: 0.9rem; justify-items: start; }
  .tiers h2 { font-size: var(--step-2); }
  .monthly ul { list-style: none; padding: 0; width: 100%; border-top: 1px solid var(--line); }
  .monthly li { border-bottom: 1px solid var(--line); }
  .monthly a { display: grid; grid-template-columns: 9rem 1fr auto; align-items: center; gap: 1rem; padding: 1rem 0.25rem; text-decoration: none; transition: background-color 150ms; }
  .monthly a:hover { background: var(--bg); }
  .amt { font-family: var(--font-display); font-size: 1.5rem; font-weight: 520; }
  .per { font-family: var(--font-sans); font-size: 0.875rem; color: var(--text-muted); margin-left: 0.15rem; }
  .name { font-weight: 600; }
  .monthly :global(.go) { color: var(--text-muted); transition: transform 160ms var(--ease-out); }
  .monthly a:hover :global(.go) { transform: translateX(3px); color: var(--text); }
  .other { padding-block: 3rem var(--section); border-top: 1px solid var(--line); }
  .other h2 { font-size: var(--step-3); margin-bottom: 1.5rem; }
  .other ul { padding-left: 1.1rem; display: grid; gap: 0.8rem; color: var(--text-muted); max-width: 44rem; }
  .other strong { color: var(--text); font-weight: 600; }
  .thanks { margin-top: 2rem; }
  @media (max-width: 52rem) {
    .top { grid-template-columns: minmax(0, 1fr); }
    .top :global(.art) { display: none; }
    .tiers { grid-template-columns: minmax(0, 1fr); }
    .pro { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 30rem) { .monthly a { grid-template-columns: 7rem 1fr auto; } }
</style>
